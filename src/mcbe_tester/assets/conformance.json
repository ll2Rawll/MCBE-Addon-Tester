      "files": {
        "manifest.json": "{\n  \"format_version\": 2,\n  \"header\": {\n    \"name\": \"Original function workshop\",\n    \"description\": \"Bounded function and tick-order reference fixture\",\n    \"uuid\": \"3968d2ad-0644-4886-95c2-d99557bdc830\",\n    \"version\": [\n      1,\n      0,\n      0\n    ],\n    \"min_engine_version\": [\n      1,\n      21,\n      90\n    ]\n  },\n  \"modules\": [\n    {\n      \"type\": \"data\",\n      \"uuid\": \"6b50c1e9-d079-42f2-b686-dcff27dc24af\",\n      \"version\": [\n        1,\n        0,\n        0\n      ]\n    }\n  ]\n}\n"
      },
      "scenario": {
        "requirements": [
          {
            "id": "contract",
            "text": "scoreboard-operations"
          }
        ],
        "steps": [
          {
            "action": {
              "type": "command",
              "command": "scoreboard objectives add points dummy"
            }
          },
          {
            "action": {
              "type": "command",
              "command": "scoreboard players set A points 10"
            }
          },
          {
            "action": {
              "type": "command",
              "command": "scoreboard players set B points 3"
            }
          },
          {
            "action": {
              "type": "command",
              "command": "scoreboard players operation A points /= B points"
            }
          },
          {
            "assert": {
              "requirement": "contract",
              "path": "/scoreboard/points/scores/A",
              "operator": "eq",
              "expected": 3
            }
          },
          {
            "action": {
              "type": "command",
              "command": "scoreboard players operation A points >< B points"
            }
          },
          {
            "action": {
              "type": "command",
              "command": "scoreboard players set B points 0"
            }
          },
          {
            "action": {
              "type": "command",
              "command": "scoreboard players operation A points /= B points"
            }
          },
          {
            "assert": {
              "requirement": "contract",
              "path": "/scoreboard/points/scores/A",
              "operator": "eq",
              "expected": 3
            }
          }
        ]
      }
    },
