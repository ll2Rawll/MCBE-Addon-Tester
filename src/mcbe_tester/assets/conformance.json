        "functions/init.mcfunction": "# Run once before advancing the fixture.\nscoreboard objectives add timer dummy\nscoreboard players set Clock timer 0\ntag @s add initialized\n",
        "functions/tick.json": "{\n  \"values\": [\n    \"tick/add\",\n    \"tick/mark\"\n  ]\n}\n",
        "functions/move.mcfunction": "# Inherits execution position and executor from its caller.\ntp @s ~2 ~ ~\n",
        "functions/tick/mark.mcfunction": "execute if entity @a[tag=initialized] if score Clock timer matches 3 run tag @a add third_tick\n",
        "functions/tick/add.mcfunction": "execute if entity @a[tag=initialized] run scoreboard players add Clock timer 1\n"
      },
      "scenario": {
        "requirements": [
          {
            "id": "contract",
            "text": "tick-function-order"
          }
        ],
        "steps": [
          {
            "action": {
              "type": "command",
              "command": "function init"
            }
          },
          {
            "action": {
              "type": "tick",
              "ticks": 4
            }
          },
          {
            "assert": {
              "requirement": "contract",
              "path": "/scoreboard/timer/scores/Clock",
              "operator": "eq",
              "expected": 4
            }
          },
