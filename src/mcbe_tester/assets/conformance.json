      "id": "early-world-unavailable",
      "kind": "scenario",
      "area": "script",
      "source": "privileges",
      "files": {
        "manifest.json": "{\"format_version\": 2, \"header\": {\"name\": \"Original contract fixture\", \"description\": \"Project-authored reference test\", \"uuid\": \"2579eacb-9da9-4778-8cfe-b391305c338c\", \"version\": [1, 0, 0], \"min_engine_version\": [1, 21, 100]}, \"modules\": [{\"type\": \"data\", \"uuid\": \"da7fc63b-417c-455a-a0e5-27f47ee1664d\", \"version\": [1, 0, 0]}, {\"type\": \"script\", \"language\": \"javascript\", \"entry\": \"scripts/main.js\", \"uuid\": \"28ed07da-8ec1-45da-b2c1-ec349e1bb117\", \"version\": [1, 0, 0]}], \"dependencies\": [{\"module_name\": \"@minecraft/server\", \"version\": \"2.0.0\"}, {\"module_name\": \"@minecraft/server-ui\", \"version\": \"2.0.0\"}]}",
        "scripts/main.js": "import {world,system} from '@minecraft/server';\nlet rejected=false;try{world.getAllPlayers();}catch{rejected=true;}world.afterEvents.worldLoad.subscribe(()=>world.setDynamicProperty('rejected',rejected));"
      },
      "scenario": {
        "requirements": [
          {
            "id": "contract",
            "text": "early-world-unavailable"
          }
        ],
        "steps": [
          {
            "assert": {
              "requirement": "contract",
              "path": "/dynamic_properties/rejected",
              "operator": "eq",
              "expected": true
            }
          }
        ]
      }
    },
    {
      "id": "startup-before-world-load",
      "kind": "scenario",
      "area": "script",
      "source": "privileges",
      "files": {
        "manifest.json": "{\"format_version\": 2, \"header\": {\"name\": \"Original contract fixture\", \"description\": \"Project-authored reference test\", \"uuid\": \"2579eacb-9da9-4778-8cfe-b391305c338c\", \"version\": [1, 0, 0], \"min_engine_version\": [1, 21, 100]}, \"modules\": [{\"type\": \"data\", \"uuid\": \"da7fc63b-417c-455a-a0e5-27f47ee1664d\", \"version\": [1, 0, 0]}, {\"type\": \"script\", \"language\": \"javascript\", \"entry\": \"scripts/main.js\", \"uuid\": \"28ed07da-8ec1-45da-b2c1-ec349e1bb117\", \"version\": [1, 0, 0]}], \"dependencies\": [{\"module_name\": \"@minecraft/server\", \"version\": \"2.0.0\"}, {\"module_name\": \"@minecraft/server-ui\", \"version\": \"2.0.0\"}]}",
        "scripts/main.js": "import {world,system} from '@minecraft/server';\nconst order=['module'];system.beforeEvents.startup.subscribe(()=>order.push('startup'));world.afterEvents.worldLoad.subscribe(()=>{order.push('worldLoad');world.setDynamicProperty('order',order.join(','));});"
      },
      "scenario": {
        "requirements": [
          {
            "id": "contract",
            "text": "startup-before-world-load"
          }
        ],
        "steps": [
          {
            "assert": {
              "requirement": "contract",
              "path": "/dynamic_properties/order",
              "operator": "eq",
              "expected": "module,startup,worldLoad"
            }
          }
        ]
      }
    },
