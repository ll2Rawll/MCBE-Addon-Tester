        "scripts/main.js": "import {world,system} from '@minecraft/server';\nlet blocked=false;world.beforeEvents.chatSend.subscribe(()=>{try{world.setDynamicProperty('write',1);}catch{blocked=true;}system.run(()=>world.setDynamicProperty('blocked',blocked));});"
